# Demo mode stays on by default. Set to false to use the local API.
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# Zero-cost local database. Use :memory: for tests.
CARAVA_SQLITE_PATH=.data/carava.sqlite

# Dev OTP is printed to the server console. Never expose it in public production.
CARAVA_OTP_SECRET=change-me-local-only
CARAVA_OTP_TTL_SECONDS=600
CARAVA_SESSION_TTL_SECONDS=86400
CARAVA_EXPOSE_DEV_OTP=true

# Optional self-hosted services (Docker Compose). Not required for the default app.
POSTGRES_URL=postgresql://carava:carava@localhost:5432/carava
REDIS_URL=redis://localhost:6379
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=carava
MINIO_SECRET_KEY=carava-local
MAILPIT_SMTP_URL=smtp://localhost:1025
